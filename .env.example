# GEMINI_API_KEY: Required for Gemini AI Assistant API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional secret used to sign custom email/password session tokens (ephemeral key generated if unset).
SESSION_SECRET=

# PAYMENT_PROVIDER_KEY: Optional Stripe/payment gateway secret key. Leave empty to operate in clearly labeled sandbox/pending mode.
PAYMENT_PROVIDER_KEY=
